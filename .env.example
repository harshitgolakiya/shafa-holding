# Public canonical URL used for metadata. Replace for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL database for the CMS and contact inbox (tables are created automatically).
DATABASE_URL=mysql://user:password@localhost:3306/shafa
# ...or individual settings instead of DATABASE_URL:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# First CMS administrator, created on first sign-in while no users exist. Remove afterwards.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
CMS_ADMIN_NAME=Administrator

# Optional: email notifications for new contact inquiries.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Shafa Holding Website <no-reply@example.com>"
# CONTACT_NOTIFY_TO=info@shafa.com
